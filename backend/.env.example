PORT=4000
NODE_ENV=development

# PostgreSQL (Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/kamancha

# MongoDB Atlas
MONGODB_URI=mongodb://localhost:27017/kamancha

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change_me_in_production_super_secret_key_minimum_32_chars
JWT_REFRESH_SECRET=change_me_refresh_super_secret_key_minimum_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=Kamancha Restaurant <your@gmail.com>

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Admin
ADMIN_SECRET=admin_bootstrap_secret
