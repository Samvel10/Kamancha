generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int           @id @default(autoincrement())
  email     String        @unique
  name      String
  phone     String?
  password  String
  role      Role          @default(USER)
  status    AccountStatus @default(ACTIVE)
  createdById Int?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  reservations    Reservation[]
  createdUsers    User[]            @relation("CreatedBy")
  createdBy       User?             @relation("CreatedBy", fields: [createdById], references: [id])
  pagePermissions PagePermission[]  @relation("PermissionTarget")
  grantedPerms    PagePermission[]  @relation("PermissionGrantedBy")
  staffProfile    StaffProfile?
  kpiReceived     KpiEntry[]        @relation("KpiTarget")
  kpiIssued       KpiEntry[]        @relation("KpiIssuer")
  feedback        Feedback[]
}

model Hall {
  id          Int     @id @default(autoincrement())
  name        String
  nameHy      String
  capacity    Int
  description String?
  isActive    Boolean @default(true)

  reservations Reservation[]
}

model Reservation {
  id               Int               @id @default(autoincrement())
  name             String
  phone            String
  email            String
  date             DateTime          @db.Date
  time             String
  guests           Int
  hallId           Int
  status           ReservationStatus @default(PENDING)
  confirmationCode String            @unique
  notes            String?
  lang             String            @default("hy")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  hall   Hall  @relation(fields: [hallId], references: [id])
  user   User? @relation(fields: [userId], references: [id])
  userId Int?
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PagePermission {
  id           Int      @id @default(autoincrement())
  userId       Int
  resource     String
  canView      Boolean  @default(true)
  canEdit      Boolean  @default(false)
  canDelete    Boolean  @default(false)
  grantedById  Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User @relation("PermissionTarget", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User @relation("PermissionGrantedBy", fields: [grantedById], references: [id])

  @@unique([userId, resource])
  @@index([userId])
}

model StaffProfile {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  position   String?
  baseSalary Int      @default(0)
  hiredAt    DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KpiEntry {
  id          Int       @id @default(autoincrement())
  userId      Int
  type        KpiType
  amount      Int
  reason      String
  issuedById  Int
  voided      Boolean   @default(false)
  voidedAt    DateTime?
  createdAt   DateTime  @default(now())

  user     User @relation("KpiTarget", fields: [userId], references: [id], onDelete: Cascade)
  issuedBy User @relation("KpiIssuer", fields: [issuedById], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model Feedback {
  id        Int      @id @default(autoincrement())
  userId    Int?
  rating    Int
  text      String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([approved, createdAt])
}

enum Role {
  USER
  DEVELOPER
  MANAGER
  DIRECTOR
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum KpiType {
  FINE
  BONUS
}
